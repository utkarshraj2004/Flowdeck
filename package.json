{
  "name": "flowdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted team work management with collaborative boards, lists, cards, and real-time updates.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "migrate": "node dist/server/cli.js migrate",
    "cli": "tsx server/src/cli.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/compress": "9.2.1",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.5",
    "fractional-indexing": "4.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@playwright/test": "1.64.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.5",
    "lucide-react": "1.45.0",
    "markdown-it": "15.0.2",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "ws": "8.22.0"
  }
}
