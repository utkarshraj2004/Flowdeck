# Copy to .env (never commit .env) and fill in real values.

# Address teammates type into their browser. Used in setup and invite links.
# Examples: http://192.168.1.20:8080   https://flowdeck.example.com
FLOWDECK_BASE_URL=http://localhost:8080

# Database password (letters and digits only). Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Host port for the app (default 8080).
FLOWDECK_PORT=8080

# Maximum size of one uploaded file, in MB (default 25).
MAX_UPLOAD_MB=25

# Set to true only when Flowdeck runs behind a reverse proxy you control (e.g. the https profile).
FLOWDECK_TRUST_PROXY=false

# Session cookies are marked Secure automatically when FLOWDECK_BASE_URL starts with https://.
# Override with true/false only if you know you need to.
FLOWDECK_COOKIE_SECURE=

# Only for the optional https profile: the DNS name Caddy serves.
FLOWDECK_DOMAIN=flowdeck.example.com

# Optional email through your own SMTP server (leave empty to keep email off).
# Format: smtp://user:password@mail.example.com:587  (smtps://… for port 465). Never commit real credentials.
FLOWDECK_SMTP_URL=
# Sender shown in emails, e.g. Flowdeck <flowdeck@example.com>
FLOWDECK_MAIL_FROM=
# Minutes an unread notification waits before it is included in an opt-in digest email (default 15).
FLOWDECK_EMAIL_DIGEST_MINUTES=

# Webhooks to private, loopback or LAN addresses are refused unless this is true.
FLOWDECK_WEBHOOK_ALLOW_PRIVATE=false

# Object limits (empty = default): FLOWDECK_LIMIT_OPEN_CARDS_PER_BOARD (5000), FLOWDECK_LIMIT_OPEN_LISTS_PER_BOARD (475),
# FLOWDECK_LIMIT_LABELS_PER_BOARD (950), FLOWDECK_LIMIT_CHECKLISTS_PER_CARD (50), FLOWDECK_LIMIT_ITEMS_PER_CHECKLIST (200),
# FLOWDECK_LIMIT_ATTACHMENTS_PER_CARD (100).
